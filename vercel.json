{
  "functions": {
    "api/cover-gif.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/app-update.js": {
      "includeFiles": "{index.html,styles.css,apple-ui.css,mini.html,package.json,src/**,examples/**}"
    }
  },
  "rewrites": [
    {
      "source": "/update/lyricviewer/cover/:sf/:id.gif",
      "destination": "/api/cover-gif?id=:id&sf=:sf"
    },
    {
      "source": "/cover/:sf/:id.gif",
      "destination": "/api/cover-gif?id=:id&sf=:sf"
    },
    {
      "source": "/update/lyricviewer/package.json",
      "destination": "/api/app-update?file=package.json"
    },
    {
      "source": "/update/lyricviewer/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/update/lyricviewer",
      "destination": "/update/lyricviewer/index.html",
      "permanent": false
    },
    {
      "source": "/update/lyricviewer/",
      "destination": "/update/lyricviewer/index.html",
      "permanent": false
    },
    {
      "source": "/download/lyricviewer",
      "destination": "/download/lyricviewer/",
      "permanent": false
    }
  ]
}
